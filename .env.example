GEMINI_API_KEY=
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite
# Qdrant: leave empty to use the embedded store in data/index/best/qdrant; set for a server
QDRANT_URL=
QDRANT_API_KEY=
# Langfuse (optional): Cloud by default, self-hosted -> set LANGFUSE_HOST
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# RAGAS gate / alerts
FAITHFULNESS_GATE=0.75
ALERT_THRESHOLD=0.80
ALERT_WEBHOOK_URL=